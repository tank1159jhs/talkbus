# Backend 환경 변수 설정 예시
# .env 파일로 저장하고 실제 값을 입력하세요

# 애플리케이션
PORT=3000
NODE_ENV=development

# 데이터베이스
DATABASE_URL=postgresql://user:password@localhost:5432/talkbus_db

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# i18n
DEFAULT_LANGUAGE=ko

# 프로필 이미지 저장 경로
UPLOAD_DIR=./uploads

# 로깅
LOG_LEVEL=debug
