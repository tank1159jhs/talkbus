# Flutter 앱 설정 예시
# lib/config.dart 또는 환경별로 관리하세요

# API 설정
API_BASE_URL=http://10.0.2.2:3000  # Android 에뮬레이터
# API_BASE_URL=http://127.0.0.1:3000  # iOS 시뮬레이터
# API_BASE_URL=http://localhost:3000  # Desktop

# WebSocket
WS_URL=ws://10.0.2.2:3000  # Android 에뮬레이터
# WS_URL=ws://127.0.0.1:3000  # iOS 시뮬레이터
# WS_URL=ws://localhost:3000  # Desktop

# 기능 플래그
ENABLE_DEBUG_LOGS=true
ENABLE_WEBSOCKET=false  # 현재는 폴링 기반
POLLING_INTERVAL_SECONDS=3
